<?xml version="1.0" encoding="UTF-8"?>

<!--
  gcc33 / E0C33 Family C Compiler ABI (sm_33.pdf sections 6.5.3-6.5.5).

  Arguments:  r12, r13, r14, r15, then stack (word-aligned, extra args at SP+4).
  Return:     r10 (32-bit), r11:r10 (64-bit / double, r10=low).
  Callee-saved: r0-r3 (pushn/popn), plus reserved global pointer r8.
  Scratch:    r4-r7, r9 (ext33), r10-r15.

  gcc33 reserves r8 as the global pointer; do not treat it as an argument.
  The previous r6-r9 / r4 spec is preserved as compiler id "legacy".
-->
<compiler_spec>
  <data_organization>
    <machine_alignment value="4" />
    <default_alignment value="1" />
    <pointer_size value="4" />
    <char_size value="1"/>
    <short_size value="2" />
    <integer_size value="4" />
    <long_size value="4" />
    <long_long_size value="8" />
    <float_size value="4" />
    <double_size value="8" />
    <size_alignment_map>
      <entry size="1" alignment="1" />
      <entry size="2" alignment="2" />
      <entry size="4" alignment="4" />
      <entry size="8" alignment="8" />
    </size_alignment_map>
    <default_pointer_alignment value="4" />
  </data_organization>
  <stackpointer register="sp" space="ram"/>
  <funcptr align="2"/>
  <spacebase name="gp" register="r8" space="ram"/>
  <global>
    <range space="ram"/>
    <range space="gp"/>
  </global>
  <returnaddress>
    <varnode space="stack" offset="0" size="4"/>
  </returnaddress>
  <default_proto>
    <prototype name="__gcc33" extrapop="4" stackshift="4">
      <input>
        <pentry minsize="1" maxsize="4" extension="inttype">
          <register name="r12"/>
        </pentry>
        <pentry minsize="1" maxsize="4" extension="inttype">
          <register name="r13"/>
        </pentry>
        <pentry minsize="1" maxsize="4" extension="inttype">
          <register name="r14"/>
        </pentry>
        <pentry minsize="1" maxsize="4" extension="inttype">
          <register name="r15"/>
        </pentry>
        <pentry maxsize="500" minsize="1" align="4">
          <addr space="stack" offset="4"/>
        </pentry>
      </input>
      <output killedbycall="true">
        <pentry minsize="1" maxsize="4">
          <register name="r10"/>
        </pentry>
        <pentry minsize="5" maxsize="8">
          <addr space="join" piece1="r11" piece2="r10"/>
        </pentry>
      </output>
      <unaffected>
        <varnode space="ram" offset="0" size="4"/>
        <register name="sp"/>
        <register name="r0"/>
        <register name="r1"/>
        <register name="r2"/>
        <register name="r3"/>
        <register name="r8"/>
      </unaffected>
      <killedbycall>
        <register name="r4"/>
        <register name="r5"/>
        <register name="r6"/>
        <register name="r7"/>
        <register name="r9"/>
        <register name="r10"/>
        <register name="r11"/>
        <register name="r12"/>
        <register name="r13"/>
        <register name="r14"/>
        <register name="r15"/>
      </killedbycall>
      <likelytrash>
        <register name="r4"/>
        <register name="r5"/>
        <register name="r6"/>
        <register name="r7"/>
        <register name="r9"/>
        <register name="r10"/>
        <register name="r11"/>
      </likelytrash>
    </prototype>
  </default_proto>
</compiler_spec>
